# Musio - Plataforma de Música Direta ao Artista
# Copie este arquivo para .env.local e preencha com suas credenciais do projeto Supabase

# URL do seu projeto Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Chave anônima pública (anon/public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chave de serviço secreta (USO EXCLUSIVO NO SERVIDOR - NUNCA EXPONHA NO CLIENTE)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# URL base da aplicação
NEXT_PUBLIC_SITE_URL=http://localhost:3000
